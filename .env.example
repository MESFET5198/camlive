# 可选: 复制为 .env。这些只是默认值, 网页「设置」里保存的值优先
# Web 端口
PORT=8081
# 本机局域网 IP: WebRTC 需要把它告诉浏览器(ICE 候选), 填错会导致 WebRTC 黑屏
HOST_IP=192.168.31.100
# 访问密码(HTTP Basic 认证); 留空则不启用。用户名默认 admin
CAMLIVE_USER=admin
CAMLIVE_PASSWORD=
# WebRTC 播放页地址模板, {host}=浏览器访问的主机名, {id}=摄像头 id
# 走 HTTPS 反向代理时可改成 https://{host}/webrtc/{id}/
WEBRTC_URL=http://{host}:8889/{id}/
# 主机侧补光灯 light_api.py
LIGHT_API_URL=http://host.docker.internal:8788
